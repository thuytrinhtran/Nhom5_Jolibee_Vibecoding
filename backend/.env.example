# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration (Placeholder for upcoming Sprints - do not add real secrets here)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-secret-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
SUPABASE_ANON_KEY=your-anon-key-placeholder

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Mirror Supabase Auth password settings. Supabase remains final authority.
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRED_GROUPS=lower,upper,digit,symbol

# TV3 AI stays OFF by default. Enable only after approval to send pseudonymous
# schedule summaries to the chosen provider; choose model/billing separately.
TV3_AI_EXTERNAL_ENABLED=false
TV3_AI_PROVIDER=none
TV3_AI_MODEL=
# Optional development-only override; production always uses TV3_AI_MODEL.
TV3_AI_DEVELOPMENT_MODEL=
GEMINI_API_KEY=

# TV2 scheduler: keep blank until separately approved/configured.
# Requires a random server-only token of at least 32 characters AND DB enabled=true.
REGISTRATION_AUTOMATION_TOKEN=

# Enable only after reviewed TV3 draft migration is deployed and verified.
# Does not deploy SQL or enable TV4 delivery.
TV3_DRAFT_PERSISTENCE_ENABLED=false
# Enable only after the TV4 v2 migration and shared-environment acceptance.
TV4_WORKFLOW_PERSISTENCE_ENABLED=false
# Enable only after TV5 migration acceptance; test-preview always blocks writes.
TV5_PERSISTENCE_ENABLED=false
# Explicit backend-only development import context; never enable in production.
DEV_IMPORT_ENABLED=false
DEV_IMPORT_PROJECT_REF=
DEV_IMPORT_BATCH_ID=

# Isolated TV3/TV4 acceptance only. All gates remain OFF until DB/RPC/ACL review.
# Production writes require this mode. Never point it at the shared Supabase project.
# TV3_TEST_PROJECT_REF is the independently approved test project allowlist entry;
# it must match TV3_WRITE_PROJECT_REF and the project in SUPABASE_URL.
# TV3_WRITE_SCOPE_ENABLED=true
# TV3_WRITE_SCOPE_MODE=isolated-test
# TV3_TEST_PROJECT_REF=
# TV3_WRITE_PROJECT_REF=
# TV3_WRITE_BRANCH_ID=
# TV3_WRITE_PERIOD_ID=
# TV3_WRITE_START_DATE=2026-11-09
# TV3_WRITE_END_DATE=2026-11-15
TV3_TEST_PREVIEW_ENABLED=false
