# ==============================================================================
# JOLLIBEE SCHEDULING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# (Do not put real secret keys into this template file)
# ==============================================================================

# Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase (PostgreSQL & Supabase Auth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
DATABASE_URL=postgresql://postgres:your-db-password@your-project-id.supabase.co:5432/postgres

# External Integrations (Scheduled for upcoming Sprints)
# Gemini API Key (Backend AI Service)
GEMINI_API_KEY=your-gemini-api-key-placeholder

# n8n Workflow Webhooks
N8N_WEBHOOK_REMINDER_URL=http://localhost:5678/webhook/reminder
N8N_WEBHOOK_SCHEDULE_OPEN_URL=http://localhost:5678/webhook/open-schedule
